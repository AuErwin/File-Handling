[flake8]
# PEP 8's 79-column guideline predates wide monitors and is explicitly a
# "soft" limit (PEP 8 itself says teams may agree on a longer one). This
# project's GUI layout code in particular reads much better with full
# ttk.grid(...)/pack(...) calls on one line, so the team limit is 120
# columns instead. The installed flake8 checks pycodestyle, pyflakes and
# mccabe rules; docstring and naming plugins are not configured.
max-line-length = 120
exclude = .venv,myenv,__pycache__,.git
